# === MHDDoS-GUI Professional GitIgnore ===

# 1. Environment & IDEs
venv/
.venv/
.env
.idea/
.vscode/
.DS_Store
*.bak
*.tmp
*.log

# 2. Python Artifacts & Testing Caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# 3. Binaries & Compiled Executables
bin/*.exe
bin/*.bin
bin/*.so
bin/*.dylib
mhddos_go.exe

# 4. Runtime Logs, Telemetry & Temp Profiles
logs/
error_logs/
temp/
debug/
debug_temp_test/
scratch/
output/
data/output/
data/sb_profiles/
data/*.db
files/*.db
!data/assets/
!data/assets/proxies/.gitkeep

# 5. AI Agent Metadata & Scratch Workspaces
.agent/
.agents/
.superpowers/
.worktrees/
.playwright-mcp/
chat/
conductor/
graphify-out/
stitch_mhddos_gui/
MHDDoS.wiki/
think.txt
task_fix.txt
/docs
AGENTS.md
/tests
GEMINI.md
/data
.cursorrules
